# Copy to deploy/.env on the live server and fill in. Never commit the filled-in file.

# The web address staff use, pointed at this server in your domain's DNS. Caddy makes the HTTPS certificate for it.
DOMAIN=sales.example.com

# The database password. Make it long and random, for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The first Admin login, made the first time the server starts. Use your own phone and a PIN only you know.
# The server refuses the placeholder ones.
BOOTSTRAP_ADMIN_PHONE=0990000000
BOOTSTRAP_ADMIN_PIN=1234

# How many days of daily backups to keep on the server.
KEEP_DAYS=30
