# Copy to .env and change for your machine.
DATABASE_URL=postgres://sales:sales@localhost:5432/sales_dev
PORT=3000
# The address phones use to reach the server.
PUBLIC_URL=http://localhost:3000
# Folder that holds the Android app files (.apk) for the download page.
APK_DIR=apk

# Placeholders for the first admin login, not real numbers. Change these before go-live.
BOOTSTRAP_ADMIN_PHONE=0990000000
BOOTSTRAP_ADMIN_PIN=1234
